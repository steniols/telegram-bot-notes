# Token do bot, gerado pelo @BotFather no Telegram
BOT_TOKEN=

# Seu ID numérico do Telegram. Só este usuário poderá usar o bot.
# Deixe vazio na primeira execução: o bot responde com o seu ID.
ALLOWED_USER_ID=

# Fuso horário usado nos lembretes
TZ=America/Sao_Paulo

# Dashboard web
DASHBOARD_PORT=3000
# 127.0.0.1 = só acessível neste computador. Use 0.0.0.0 num servidor (e defina DASHBOARD_TOKEN).
DASHBOARD_HOST=127.0.0.1
# Se definido, o dashboard exige ?token=VALOR na URL
DASHBOARD_TOKEN=

# Caminho do banco SQLite
DB_PATH=data/cerebro.db
